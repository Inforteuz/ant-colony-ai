# ==========================================================
# Ant Colony AI — muhit o'zgaruvchilari namunasi
# Bu faylni `.env` nomi bilan nusxalang va o'z kalitlaringizni qo'ying:
#     cp .env.example .env
# `.env` fayli git'ga TUSHMAYDI (.gitignore da).
# Hech bo'lmasa BITTA provayder kaliti kerak.
# ==========================================================

# --- LLM provayderlari (kamida bittasi kerak) ---
# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (ko'p modelga bitta kalit) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq Cloud (juda tez) — https://console.groq.com/keys
GROQ_API_KEY=

# GitHub Models — https://github.com/settings/tokens
GITHUB_TOKEN=

# b.ai services (OpenAI-mos, https://api.b.ai/v1)
BAI_API_KEY=

# 17.wtf API
WTF_API_KEY=

# --- Server ---
# Tarmoqqa ochish XAVFLI: platformada shell buyruqlarini bajaruvchi endpoint bor.
# Faqat ishonchli, izolyatsiyalangan tarmoqda 0.0.0.0 qiling.
ANT_HOST=127.0.0.1
ANT_PORT=8080
# Ishlab chiqish uchun avtomatik qayta yuklash (production'da 0 qoldiring)
ANT_RELOAD=0

# --- Ixtiyoriy: Telegram bot orqali masofadan boshqarish ---
TELEGRAM_BOT_TOKEN=

# --- Agent xatti-harakati (ixtiyoriy, standart qiymatlar config.py da) ---
# AGENT_MAX_TOOL_STEPS=8
# AGENT_REPAIR_THRESHOLD=80
